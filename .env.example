# Environment Variables for MKET Backend

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example: postgresql://postgres:password@localhost:5432/mket_db
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mket_db?schema=public"

# JWT Secret (Change this to a strong random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRE="30d"

# Server
PORT=3000
NODE_ENV="development"

# Cloudinary (Your existing config)
CLOUDINARY_CLOUD_NAME="daxxf6eal"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Frontend URLs (CORS)
# Use comma-separated values for local + production frontends
FRONTEND_URLS="http://localhost:1365,http://localhost:5173,http://localhost:5174,https://mket13.vercel.app"




